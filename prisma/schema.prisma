generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  phone        String?  @unique
  email        String?  @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(STORE_OWNER)

  store Store?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("users")
}

model Plan {
  id            String        @id @default(uuid()) @db.Uuid
  name          String
  billingPeriod BillingPeriod @map("billing_period")
  price         Decimal       @db.Decimal(12, 2)
  isActive      Boolean       @default(true) @map("is_active")

  subscriptions Subscription[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([name, billingPeriod])
  @@map("plans")
}

model Store {
  id          String      @id @default(uuid()) @db.Uuid
  ownerId     String      @unique @map("owner_id") @db.Uuid
  name        String
  slug        String      @unique
  description String?
  logoUrl     String?     @map("logo_url")
  phone       String?
  status      StoreStatus @default(ACTIVE)

  owner         User          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  subscription  Subscription?
  categories    Category[]
  products      Product[]
  customers     Customer[]
  orders        Order[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([ownerId])
  @@index([status])
  @@map("stores")
}

model Subscription {
  id        String             @id @default(uuid()) @db.Uuid
  storeId   String             @unique @map("store_id") @db.Uuid
  planId    String             @map("plan_id") @db.Uuid
  status    SubscriptionStatus @default(ACTIVE)
  startsAt  DateTime           @map("starts_at") @db.Timestamptz
  endsAt    DateTime           @map("ends_at") @db.Timestamptz

  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  plan  Plan  @relation(fields: [planId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status])
  @@index([endsAt])
  @@map("subscriptions")
}

model Category {
  id       String  @id @default(uuid()) @db.Uuid
  storeId  String  @map("store_id") @db.Uuid
  parentId String? @map("parent_id") @db.Uuid
  name     String
  imageUrl String? @map("image_url")

  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([storeId, name])
  @@index([storeId])
  @@index([parentId])
  @@map("categories")
}

model Product {
  id           String             @id @default(uuid()) @db.Uuid
  storeId      String             @map("store_id") @db.Uuid
  categoryId   String?            @map("category_id") @db.Uuid
  name         String
  description  String?
  price        Decimal            @db.Decimal(12, 2)
  availability ProductAvailability @default(AVAILABLE)
  status       ProductStatus      @default(ACTIVE)

  store    Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images   ProductImage[]
  variants ProductVariant[]
  orderItems OrderItem[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([storeId])
  @@index([categoryId])
  @@index([storeId, availability])
  @@index([storeId, status])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  imageUrl  String  @map("image_url")
  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([productId])
  @@index([productId, sortOrder])
  @@map("product_images")
}

model ProductVariant {
  id           String             @id @default(uuid()) @db.Uuid
  productId    String             @map("product_id") @db.Uuid
  color        String?
  size         String?
  price        Decimal?           @db.Decimal(12, 2)
  availability ProductAvailability @default(AVAILABLE)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([productId, color, size])
  @@index([productId])
  @@index([productId, availability])
  @@map("product_variants")
}

model Customer {
  id      String  @id @default(uuid()) @db.Uuid
  storeId String  @map("store_id") @db.Uuid
  name    String
  phone   String
  address String?
  notes   String?

  store  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders Order[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([storeId])
  @@index([storeId, phone])
  @@map("customers")
}

model Order {
  id           String      @id @default(uuid()) @db.Uuid
  storeId      String      @map("store_id") @db.Uuid
  customerId   String      @map("customer_id") @db.Uuid
  status       OrderStatus @default(NEW)
  totalAmount  Decimal     @map("total_amount") @db.Decimal(12, 2)
  notes        String?

  // Checkout 2 — Order Shipping Snapshot (immutable)
  shippingCity     String?
  shippingDistrict String?
  shippingAddress  String?
  shippingNotes    String?

  store     Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items     OrderItem[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([storeId])
  @@index([customerId])
  @@index([storeId, status])
  @@index([storeId, createdAt])
  @@map("orders")
}

model OrderItem {
  id         String  @id @default(uuid()) @db.Uuid
  orderId    String  @map("order_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  variantId  String? @map("variant_id")
  quantity   Int
  unitPrice  Decimal @map("unit_price") @db.Decimal(12, 2)
  totalPrice Decimal @map("total_price") @db.Decimal(12, 2)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}


enum UserRole {
  ADMIN
  STORE_OWNER

  @@map("user_role")
}

enum StoreStatus {
  ACTIVE
  SUSPENDED

  @@map("store_status")
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED

  @@map("subscription_status")
}

enum BillingPeriod {
  MONTHLY
  YEARLY

  @@map("billing_period")
}

enum ProductStatus {
  ACTIVE
  INACTIVE

  @@map("product_status")
}

enum ProductAvailability {
  AVAILABLE
  UNAVAILABLE

  @@map("product_availability")
}

enum OrderStatus {
  NEW
  CONFIRMED
  PROCESSING
  READY
  DELIVERED
  CANCELLED

  @@map("order_status")
}